# Supabase — Settings → API → Legacy API Keys → service_role (eyJ...)
SUPABASE_URL=https://xswjrolcyhzziehtnhnx.supabase.co
SUPABASE_SECRET_KEY=eyJ...

# Required in production — long random string (not SITE_URL)
SESSION_TOKEN_SECRET=replace-with-a-long-random-secret

# Keep 0 unless you intentionally want creator to add more admins via UI
ALLOW_DYNAMIC_ADMINS=0

# Production server (npm start)
PORT=4173
SITE_URL=https://bloxupgrader.com

# Persist chats, deposits, giveaways and grants across Render deploys
DATA_DIR=/var/data/bloxupgrader

